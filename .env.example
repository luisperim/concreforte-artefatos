# Configurações do Firebase (Crie um arquivo .env na raiz com suas chaves do Console Firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Credenciais Admin de demonstração (quando em modo local/demo sem Firebase Auth configurado)
VITE_DEMO_ADMIN_EMAIL=admin@concreforte.com.br
VITE_DEMO_ADMIN_PASS=admin123
